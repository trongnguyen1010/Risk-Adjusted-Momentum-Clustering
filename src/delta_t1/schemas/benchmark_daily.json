{
  "contract_format": "delta-table-contract",
  "schema_version": "1.1.0",
  "table": "benchmark_daily",
  "primary_key": [
    "index_id",
    "trade_date"
  ],
  "fields": {
    "index_id": {
      "type": "string",
      "nullable": false
    },
    "trade_date": {
      "type": "date",
      "nullable": false
    },
    "close": {
      "type": "number",
      "nullable": false,
      "exclusive_min": 0
    },
    "total_return_level": {
      "type": "number",
      "nullable": true,
      "exclusive_min": 0
    },
    "available_at": {
      "type": "datetime",
      "nullable": false
    },
    "source": {
      "type": "string",
      "nullable": false
    },
    "fetched_at": {
      "type": "datetime",
      "nullable": false
    },
    "data_version": {
      "type": "string",
      "nullable": false
    },
    "exchange": {
      "type": "string",
      "nullable": true,
      "enum": [
        "HOSE",
        "HNX",
        "UPCOM"
      ]
    },
    "index_basis": {
      "type": "string",
      "nullable": true,
      "enum": [
        "price",
        "total_return",
        "unknown",
        "synthetic"
      ]
    }
  },
  "relations": []
}
