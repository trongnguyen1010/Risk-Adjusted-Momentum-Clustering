{
  "table": "representative_pilot_universe",
  "version": "1.0.0",
  "primary_key": ["ticker"],
  "fields": {
    "security_id": {"type": "string", "nullable": true},
    "ticker": {"type": "string"},
    "exchange": {"type": "string", "enum": ["HOSE", "HNX", "UPCOM"]},
    "sector": {"type": "string", "nullable": true},
    "sector_status": {"type": "string", "enum": ["VERIFIED", "DOCUMENTED_LIMITATION", "PENDING_REVIEW"]},
    "listing_date": {"type": "date", "nullable": true},
    "history_eligibility": {"type": "string", "enum": ["TARGET_5Y", "USABLE_3Y", "SHORT_HISTORY", "UNKNOWN_PENDING_REVIEW"]},
    "selection_reason": {"type": "string"},
    "reference_only": {"type": "boolean"}
  }
}
