{
  "contract_format": "delta-table-contract",
  "schema_version": "1.0.0",
  "table": "trades",
  "primary_key": [
    "run_id",
    "trade_id"
  ],
  "fields": {
    "run_id": {
      "type": "string",
      "nullable": false
    },
    "trade_id": {
      "type": "string",
      "nullable": false
    },
    "security_id": {
      "type": "string",
      "nullable": false
    },
    "signal_time": {
      "type": "datetime",
      "nullable": false
    },
    "execution_time": {
      "type": "datetime",
      "nullable": false
    },
    "side": {
      "type": "string",
      "nullable": false,
      "enum": [
        "buy",
        "sell"
      ]
    },
    "quantity": {
      "type": "integer",
      "nullable": false,
      "min": 0
    },
    "price": {
      "type": "number",
      "nullable": true,
      "exclusive_min": 0
    },
    "notional": {
      "type": "number",
      "nullable": false,
      "min": 0
    },
    "fee": {
      "type": "number",
      "nullable": false,
      "min": 0
    },
    "tax": {
      "type": "number",
      "nullable": false,
      "min": 0
    },
    "slippage": {
      "type": "number",
      "nullable": false,
      "min": 0
    },
    "status": {
      "type": "string",
      "nullable": false,
      "enum": [
        "filled",
        "rejected"
      ]
    },
    "reject_reason": {
      "type": "string",
      "nullable": true
    },
    "data_version": {
      "type": "string",
      "nullable": false
    }
  },
  "relations": []
}
