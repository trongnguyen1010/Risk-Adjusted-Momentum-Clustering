  "snapshot_frequency": "month_end_last_trading_session",
  "eligibility_field": "market_feature_ready_v2",
  "eligibility_scope": "per_snapshot",
  "min_eligible_count": 120,
  "below_minimum_action": "skip_snapshot",
  "missing_data_policy": "exclude_security_fail_closed",
  "prohibited_missing_treatments": [
    "mean_imputation",
    "median_imputation",
    "zero_fill",
    "forward_fill",
    "backward_fill",
    "interpolation"
  ],
  "portfolio_evaluation": {
    "enabled": false
  },
  "clustering": {
    "methods": [
      "kmeans",
      "ward",
      "pca_kmeans"
    ],
    "baseline": "kmeans",
    "features": [
      "mom_21",
      "mom_63",
      "mom_126",
      "mom_252",
      "vol_63",
      "mdd_126",
      "beta_126",
      "liquidity_21"
    ],
    "input_feature_version": "1.6.0",
    "registry_metadata_version": "1.5.0",
    "winsor_quantile": 0,
    "clipping": false,
    "scaling": "robust_per_snapshot",
    "scaling_formula": "(x - median) / IQR",
    "scaler_fit_scope": "independent_snapshot",
    "k": 2,
    "k_range": [
      2,
      3,
      4,
      5,
      6,
      7,
      8
    ],
    "global_k_selection": {
      "scope": "development_only",
      "primary": "median_silhouette_max",
      "tie_break": "median_davies_bouldin_min",
      "supporting_checks": [
        "calinski_harabasz",
        "cluster_balance"
      ],
      "forbidden_metrics": [
        "return",
        "sharpe",
        "roi"
      ],
      "unresolved_exact_tie_action": "manual_review_without_holdout_or_portfolio_metrics"
    },
    "pca": {
      "role": "independent_comparator_only",
      "applies_to": [
        "pca_kmeans"
      ],
      "baseline_preprocessing": false,
      "component_rule_status": "frozen_on_development",
      "n_components": 4,
      "component_rule": "smallest_uniform_count_covering_every_development_snapshot",
      "explained_variance_threshold": 0.9,
      "freeze_evidence": "M2/artifacts/m2-task6-pca-kmeans-v1/pca_diagnostics.jsonl"
    },
    "algorithm": "pca_kmeans",
    "seed": 42,
    "n_init": 10,
    "max_iter": 300
  },
  "holdout_policy": {
    "sealed_during_development": true,
    "may_tune": [],
    "prohibited_changes": [
      "k",
      "scaler",
      "pca",
      "algorithm"
    ],
    "access_stage": "M2_TASK_11_ONLY_AFTER_DEVELOPMENT_FREEZE"
  },
  "assumptions": {
    "k_rationale": "Chọn một Global K duy nhất chỉ từ diagnostics trên 15 snapshot development; không dùng holdout hoặc portfolio performance.",
    "feature_version_compatibility": "C8 feature snapshot 1.6.0 là input M2 active; registry 1.5.0 được dùng để validate tên, formula và cluster eligibility vì tám formula market khớp; không mutate artifact C8.",
    "holdout_isolation": "Bảy snapshot holdout bị niêm phong khỏi mọi quyết định K, scaler, PCA và algorithm cho tới khi development methodology đã freeze.",
    "historical_identity": "Protocol market-only không tạo historical_identity_ready hoặc research_ready claim.",
    "pca_components": "Giữ 4 components đã dùng; kiểm chứng đây là số chiều cố định nhỏ nhất để mọi development snapshot giữ ít nhất 90% phương sai. Không thay đổi số chiều từng tháng; không dùng holdout."
  },
