{
  "contract_format": "delta-table-contract",
  "schema_version": "1.3.0",
  "table": "financial_reports",
  "primary_key": ["report_id"],
  "fields": {
    "report_id": {"type": "string", "nullable": false},
    "security_id": {"type": "string", "nullable": false},
    "fiscal_year": {"type": "integer", "nullable": false, "min": 1900},
    "fiscal_quarter": {"type": "integer", "nullable": false, "enum": [1, 2, 3, 4]},
    "period_start": {"type": "date", "nullable": false},
    "period_end": {"type": "date", "nullable": false},
    "published_at": {"type": "datetime", "nullable": false},
    "available_at": {"type": "datetime", "nullable": false},
    "statement_scope": {"type": "string", "nullable": false, "enum": ["consolidated", "separate"]},
    "audit_status": {"type": "string", "nullable": false, "enum": ["unaudited", "reviewed", "audited", "unknown"]},
    "accounting_standard": {"type": "string", "nullable": false, "enum": ["VAS", "IFRS", "other", "unknown"]},
    "revision": {"type": "integer", "nullable": false, "min": 1},
    "is_restated": {"type": "boolean", "nullable": false},
    "source_document_id": {"type": "string", "nullable": false},
    "source_document_hash": {"type": "string", "nullable": false},
    "source": {"type": "string", "nullable": false},
    "fetched_at": {"type": "datetime", "nullable": false},
    "data_version": {"type": "string", "nullable": false}
  },
  "relations": [
    {"target": "securities", "on": "security_id"}
  ]
}
