{
  "contract_format": "delta-table-contract",
  "schema_version": "1.0.0",
  "table": "shares_history",
  "primary_key": [
    "security_id",
    "effective_date"
  ],
  "fields": {
    "security_id": {
      "type": "string",
      "nullable": false
    },
    "effective_date": {
      "type": "date",
      "nullable": false
    },
    "available_at": {
      "type": "datetime",
      "nullable": false
    },
    "listed_shares": {
      "type": "integer",
      "nullable": true,
      "min": 0
    },
    "outstanding_shares": {
      "type": "integer",
      "nullable": true,
      "min": 0
    },
    "issued_shares": {
      "type": "integer",
      "nullable": true,
      "min": 0
    },
    "treasury_shares": {
      "type": "integer",
      "nullable": true,
      "min": 0
    },
    "source": {
      "type": "string",
      "nullable": false
    },
    "fetched_at": {
      "type": "datetime",
      "nullable": false
    },
    "data_version": {
      "type": "string",
      "nullable": false
    }
  },
  "relations": [
    {
      "target": "securities",
      "on": "security_id"
    }
  ]
}
